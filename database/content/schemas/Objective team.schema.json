{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective_team.schema.json",
  "title": "Objectif - mode par équipes",
  "$defs": {
    "team_side": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/slug" },
          "minItems": 2,
          "maxItems": 2,
          "$comment": "Ton commentaire disait '2 slugs de characters/' : je pars du principe que chaque équipe fait 2 joueurs (lobby fixé à 4). Dis-moi si ce n'est pas toujours le cas."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/objective_step" }
        },
        "victory_text": { "type": "string", "minLength": 1 },
        "reward": { "$ref": "common.schema.json#/$defs/reward" },
        "fail_condition": { "type": "string" },
        "fail_consequence": { "$ref": "common.schema.json#/$defs/fail_consequence_disposition" }
      },
      "required": ["characters", "steps", "victory_text", "reward", "fail_condition", "fail_consequence"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "difficulty": { "$ref": "common.schema.json#/$defs/difficulty" },
    "team_a": { "$ref": "#/$defs/team_side" },
    "team_b": { "$ref": "#/$defs/team_side" }
  },
  "required": ["name", "description", "difficulty", "team_a", "team_b"]
}