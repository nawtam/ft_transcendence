{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Événement",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "condition": { "type": "string", "minLength": 1 },
    "event_place": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/slug" },
      "description": "Lieux où l'événement peut se déclencher. Vide = pas de restriction de lieu (à confirmer)."
    },
    "probability": { "$ref": "common.schema.json#/$defs/probability" },
    "fréquence": {
      "type": "string",
      "minLength": 1,
      "examples": ["1x par partie", "1x par lieu visité"],
      "$comment": "Clé accentuée reprise telle quelle depuis ton template. Attention, certains outils/CLI gèrent mal les clés non-ASCII : envisage 'frequence' sans accent si tu rencontres des soucis d'encodage."
    },
    "quest": { "$ref": "common.schema.json#/$defs/optional_ref" },
    "npc": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "monster": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "possible_outcomes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Pistes narratives données à l'IA : on suppose qu'il en faut au moins une pour que l'événement soit exploitable."
    },
    "asset": { "$ref": "common.schema.json#/$defs/asset_path" }
  },
  "required": [
    "name", "description", "condition", "event_place", "probability",
    "fréquence", "quest", "npc", "monster", "possible_outcomes", "asset"
  ]
}