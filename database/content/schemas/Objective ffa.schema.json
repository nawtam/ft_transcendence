{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective_ffa.schema.json",
  "title": "Objectif - mode chacun pour soi (FFA)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/objective_step" }
    },
    "victory_text": { "type": "string", "minLength": 1 },
    "reward": { "$ref": "common.schema.json#/$defs/reward" },
    "fail_condition": { "type": "string" }
  },
  "required": ["name", "description", "steps", "victory_text", "reward", "fail_condition"]
}